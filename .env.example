# Glimmer (local via Ollama) — Muse Glimmer 30B via Ollama (Apache 2.0, HF meta-models/Muse-Glimmer-30B)
OLLAMA_HOST=http://localhost:11434
GLIMMER_MODEL=muse-glimmer
FALLBACK_MODEL=llama3.1:8b
# Fetch timeout for Ollama requests in milliseconds (default 120000)
GLIMMER_TIMEOUT_MS=120000

# Muse Spark 1.2 (API)
MUSE_SPARK_API_KEY=
MUSE_SPARK_BASE_URL=https://api.muse-spark.example/v1
MUSE_SPARK_MODEL=muse-spark-1.2
# Fetch timeout for Muse Spark requests in milliseconds (default 120000)
MUSE_SPARK_TIMEOUT_MS=120000

# Eval judge (Anthropic) — optional; if missing, eval uses rubric-only scoring
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-4-6
