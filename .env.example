# Glimmer (local via Ollama)
OLLAMA_HOST=http://localhost:11434
GLIMMER_MODEL=glimmer:8b-instruct-q4_K_M
# Fallback when Glimmer weights are not yet public — used by glimmer:setup and CI
FALLBACK_MODEL=llama3.1:8b

# Muse Spark 1.2 (API)
MUSE_SPARK_API_KEY=
MUSE_SPARK_BASE_URL=https://api.muse-spark.example/v1
MUSE_SPARK_MODEL=muse-spark-1.2

# Eval judge (Anthropic) — optional; if missing, eval uses rubric-only scoring
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-4-6
