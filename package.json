{
  "name": "glimmer-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local CLI for Meta's Glimmer + Muse Spark 1.2 tool-use eval harness — Ollama + stubbed tools, reproducible comparison",
  "type": "module",
  "bin": {
    "glimmer": "bin/glimmer",
    "glimmer-cli": "bin/glimmer"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "cli": "tsx --env-file-if-exists=.env.local src/cli.ts",
    "dev": "tsx --env-file-if-exists=.env.local src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "eval": "tsx --env-file-if-exists=.env.local src/eval/runner.ts",
    "eval:mock": "tsx --env-file-if-exists=.env.local src/eval/runner.ts --mock",
    "glimmer:setup": "tsx --env-file-if-exists=.env.local scripts/glimmer-setup.ts",
    "glimmer:pull": "tsx --env-file-if-exists=.env.local scripts/glimmer-setup.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@biomejs/biome": "2.2.0",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.6",
    "tsx": "^4.22.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
